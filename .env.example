# .env.example — Paper Trading Platform
# Copy this file to .env and fill in all values before starting services.
# NEVER commit .env to version control.
# This file contains only placeholder values — no real secrets.

# ──────────────────────────────────────────────
# Environment
# ──────────────────────────────────────────────
NODE_ENV=development
PYTHON_ENV=development

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trade_dev
POSTGRES_USER=trade_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql://trade_user:CHANGE_ME_strong_password_here@localhost:5432/trade_dev

# Test database (separate from dev — never use dev DB for tests)
TEST_DATABASE_URL=postgresql://trade_user:CHANGE_ME_strong_password_here@localhost:5432/trade_test

# ──────────────────────────────────────────────
# API Service (apps/api)
# ──────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_generate_a_strong_random_secret_here

# JWT secret (if using JWT instead of server sessions)
# JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret_here
# JWT_EXPIRY_SECONDS=3600

# Internal service token (shared between api and trading-engine)
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=CHANGE_ME_generate_internal_token_here

# ──────────────────────────────────────────────
# Trading Engine (services/trading-engine)
# ──────────────────────────────────────────────
TRADING_ENGINE_PORT=8000
TRADING_ENGINE_HOST=0.0.0.0
TRADING_ENGINE_URL=http://localhost:8000
# INTERNAL_SERVICE_TOKEN above is shared by both apps/api and services/trading-engine —
# both load the same root .env, so it is declared once.

# ──────────────────────────────────────────────
# Frontend (apps/web)
# ──────────────────────────────────────────────
NUXT_PUBLIC_API_URL=http://localhost:4000
NUXT_PUBLIC_TRADING_MODE=PAPER

# ──────────────────────────────────────────────
# Paper Trading Configuration
# ──────────────────────────────────────────────
# Initial paper cash balance for the simulated portfolio
INITIAL_PAPER_CASH_USD=100000

# ──────────────────────────────────────────────
# SAFETY — Do not change these in paper trading phase
# ──────────────────────────────────────────────
TRADING_MODE=PAPER
LIVE_BROKER_ENABLED=false

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=info
# Options: error, warn, info, debug
