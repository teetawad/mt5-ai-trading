# .env.example - MT5 AI DEMO Trading Lab
# Copy to .env. Never commit credentials or MT5 passwords.

NODE_ENV=development
PYTHON_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trade_dev
POSTGRES_USER=trade_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql://trade_user:CHANGE_ME_strong_password_here@localhost:5432/trade_dev
TEST_DATABASE_URL=postgresql://trade_user:CHANGE_ME_strong_password_here@localhost:5432/trade_test

API_PORT=4000
API_HOST=0.0.0.0
SESSION_SECRET=CHANGE_ME_generate_a_strong_random_secret_here
INTERNAL_SERVICE_TOKEN=CHANGE_ME_generate_internal_token_here
# Comma-separated allow-list. Unset uses the built-in default covering the
# web dev origin plus the Capacitor iOS WebView schemes (capacitor://localhost,
# http://localhost, ionic://localhost) - see apps/api/src/app.ts. Add your
# production HTTPS web origin here for a real deployment.
# CORS_ORIGIN=http://localhost:3000,capacitor://localhost

TRADING_ENGINE_PORT=8000
TRADING_ENGINE_HOST=0.0.0.0
TRADING_ENGINE_URL=http://localhost:8000

# MT5 DEMO ONLY. Password is entered in the MT5 terminal, not stored here.
MT5_TERMINAL_PATH=
MT5_ALLOWED_DEMO_LOGIN=
MT5_ALLOWED_DEMO_SERVER=
MT5_EXECUTION_MODE=demo
MT5_AUTO_DEMO_ENABLED=false
MT5_SCANNER_INTERVAL_MS=60000
MT5_QUOTE_STALE_SECONDS=120
# Optional terminal-side session export used when the Python MT5 package does not expose broker sessions.
MT5_SESSION_BRIDGE_PATH=
MT5_SESSION_CACHE_PATH=.trade-runtime/mt5-session-cache.json

# DEMO Fast Learning risk profile (mt5-risk-settings.ts). When true, the
# MT5_MAX_* defaults below loosen to the values shown — but only for a
# verified MT5 DEMO account (effectiveMt5RiskSettings falls back to the
# strict defaults otherwise). Kill switch, margin, and every other hard block
# are unaffected. Leave MT5_MAX_* unset to use these profile-aware defaults,
# or set any of them explicitly to override the profile either way.
FAST_LEARNING_RISK_PROFILE=false
# MT5_MAX_SIMULTANEOUS_POSITIONS=10   # default: 3, or 10 when the profile above is on
# MT5_MAX_TRADES_PER_DAY=30           # default: 6, or 30 when the profile above is on
# MT5_MAX_RISK_PER_TRADE_PCT=1.0      # default: 0.50, or 1.0 when the profile above is on
# MT5_MAX_LOSS_PER_TRADE=3.00         # default: 100.00, or 3.00 when the profile above is on

# V3 Trading-Specialist AI. Provider/model are configurable, never hardcoded.
# If TRADING_AI_PROVIDER is unset (or its credentials are missing), the app
# shows "AI PROVIDER NOT CONFIGURED" instead of ever faking a recommendation.
# OpenAI is the primary/default provider. Server-side only: OPENAI_API_KEY is
# never sent to Nuxt, the browser, public runtime config, API responses, or logs.
TRADING_AI_PROVIDER=openai
TRADING_AI_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
# Alternative provider — set TRADING_AI_PROVIDER=anthropic and fill this in
# to switch instead of OpenAI. Only one provider is active at a time.
ANTHROPIC_API_KEY=
AI_TRADE_PLAN_WATCHER_INTERVAL_MS=15000

# "FIND BEST TRADES" two-stage scanner (opportunity-scan.ts). Never sends
# every synced MT5 instrument to OpenAI — only the top-N technically
# shortlisted candidates.
AI_BEST_TRADES_SHORTLIST_SIZE=20
AI_BEST_TRADES_TOP_COUNT=10
AI_BEST_TRADES_REUSE_MAX_AGE_MINUTES=180

# M5 Fast Learning Mode: auto-triggers one AI cycle per completed M5 candle
# and creates Shadow Trades (simulated only — never a real order_send) so
# outcomes can be collected much faster for a future ML Trade Critic. Off by
# default. Never changes per-trade risk sizing (see MT5_MAX_* above).
FAST_LEARNING_MODE=false
M5_CYCLE_POLL_INTERVAL_MS=10000
M5_AI_SHORTLIST_SIZE=10
M5_PLAN_EXPIRY_MINUTES=30
M5_REUSE_MAX_AGE_MINUTES=4
M5_SHADOW_WATCHER_INTERVAL_MS=20000
M5_SHADOW_MAX_HOLDING_MINUTES=180
MT5_ONE_ACTIVE_PLAN_PER_SYMBOL=true

# Final Quality Score / REAL DEMO selectivity: Shadow Trading keeps
# collecting every technically-valid M5 setup, but only the strongest ones
# (Final Quality >= REAL_DEMO_MIN_FINAL_SCORE, Risk-PASS, broker-validated,
# ranked by Final Quality DESC and capped at REAL_DEMO_TOP_CANDIDATES) are
# ever surfaced as REAL DEMO READY per completed M5 cycle. Never auto-places
# an order — the owner still manually clicks the DEMO execution button.
REAL_DEMO_MIN_FINAL_SCORE=65
REAL_DEMO_TOP_CANDIDATES=5
FINAL_SCORE_AI_PROFITABILITY_WEIGHT=0.35
FINAL_SCORE_TRADEABILITY_WEIGHT=0.20
FINAL_SCORE_CONFIDENCE_WEIGHT=0.15
FINAL_SCORE_TIMEFRAME_ALIGNMENT_WEIGHT=0.15
FINAL_SCORE_HISTORY_WEIGHT=0.15
HISTORICAL_MIN_SAMPLES=20
HISTORICAL_FULL_WEIGHT_SAMPLES=50
RECENT_LOSS_STREAK_THRESHOLD=3
RECENT_LOSS_PENALTY_POINTS=10
QUALITY_BASED_DEMO_SIZING=true
QUALITY_TIER_HIGH_MIN_SCORE=80
QUALITY_TIER_HIGH_MAX_LOSS_USD=4.50
QUALITY_TIER_NORMAL_MIN_SCORE=65
QUALITY_TIER_NORMAL_MAX_LOSS_USD=3.00
ML_RECOMMENDED_MIN_SAMPLES=200

# Web dev (this file's default): http://localhost:4000
# iOS device/simulator on the same LAN as this machine (see docs/mobile-ios.md
# for the full walkthrough): set to this machine's LAN IP, e.g.
# NUXT_PUBLIC_API_URL=http://192.168.1.50:4000 - passed at `npm run build:mobile`
# time, never hardcoded into a committed config file.
# Production: NUXT_PUBLIC_API_URL=https://<your-api-domain>
NUXT_PUBLIC_API_URL=http://localhost:4000
NUXT_PUBLIC_TRADING_MODE=MT5_DEMO

TRADING_MODE=MT5_DEMO
LIVE_BROKER_ENABLED=false
LOG_LEVEL=info
